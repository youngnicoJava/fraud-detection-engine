{
  "name": "fraud-detection-analyst-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175 --strictPort",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html,mjs}\""
  },
  "dependencies": {
    "keycloak-js": "^26.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
